// 5장 Jenkinsfile (Declarative Pipeline). 저장소 맨 위에 두고 코드와 같은 커밋으로 관리한다.
// 이 장에서는 Jenkins 서버를 띄우지 않고, pipelines_ch05_jenkins.py가 이 파일의 일부 문법만 읽어 단계를 실제로 실행한다.
// 실제 Jenkins에서는 Pipeline 플러그인 묶음과 JUnit 플러그인이 필요하다.
// 컨테이너 안에서 돌리려면 agent any 대신 agent { docker { image '4장 이미지@sha256:...' } }를 쓴다(Docker Pipeline 플러그인 필요).
pipeline {
  agent any
  options {
    skipStagesAfterUnstable()
  }
  environment {
    OMP_NUM_THREADS = '2'
  }
  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }
    stage('Lint') {
      steps {
        sh 'python -m compileall -q churn tests ci'
      }
    }
    stage('Unit/Data tests') {
      steps {
        sh 'python -m pytest -q tests --ignore=tests/test_model.py --junitxml=reports/unit.xml'
      }
    }
    stage('Build image') {
      steps {
        sh 'python ci/build_image.py'
      }
    }
    stage('Model perf test') {
      steps {
        sh 'python -m churn.train'
        sh 'python -m pytest -q tests/test_model.py --junitxml=reports/model.xml'
      }
    }
    stage('Push image') {
      when {
        expression { currentBuild.result == null || currentBuild.result == 'SUCCESS' }
      }
      steps {
        sh 'python ci/push.py'
      }
    }
  }
  post {
    always {
      junit 'reports/*.xml'
      archiveArtifacts 'results/*.json'
    }
  }
}
